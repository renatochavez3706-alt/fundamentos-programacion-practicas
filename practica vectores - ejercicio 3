#include<iostream>
using namespace std;

void leerVector(float v[], int n);
float calcularPromedio(float v[], int n);
void mostrarResultado(float v[], int n, float promedio);

int main(){
    float v[100];
    int n;
    float promedio;

    cout<<"Ingrese la cantidad de valores: "<<endl;
    cin>>n;

    leerVector(v, n);

    promedio = calcularPromedio(v, n);

    mostrarResultado(v, n, promedio);

    return 0;
}

void leerVector(float v[], int n){
    for(int i=0; i<n; i++){
        cout<<"Ingrese el valor "<<i+1<<": "<<endl;
        cin>>v[i];
    }
}

float calcularPromedio(float v[], int n){
    float suma = 0;

    for(int i=0; i<n; i++){
        suma = suma + v[i];
    }

    return suma / n;
}

void mostrarResultado(float v[], int n, float promedio){
    cout<<"VALORES REGISTRADOS: "<<endl;

    for(int i=0; i<n; i++){
        cout<<v[i]<<" ";
    }

    cout<<endl;
    cout<<"El promedio es: "<<promedio<<endl;
}
