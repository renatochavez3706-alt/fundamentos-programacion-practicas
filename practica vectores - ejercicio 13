#include<iostream>
using namespace std;

void leerVector(int v[], int n);
void revertirVector(int v[], int n);
void mostrarVector(int v[], int n);

int main(){
    int v[100];
    int n;

    cout<<"Ingrese la cantidad de elementos: ";
    cin>>n;

    leerVector(v, n);

    revertirVector(v, n);

    cout<<"\nVECTOR INVERTIDO:"<<endl;
    mostrarVector(v, n);

    return 0;
}

void leerVector(int v[], int n){
    for(int i=0; i<n; i++){
        cout<<"Ingrese el valor "<<i+1<<": ";
        cin>>v[i];
    }
}

void revertirVector(int v[], int n){
    int aux;

    for(int i=0; i<n/2; i++){
        aux = v[i];
        v[i] = v[n-1-i];
        v[n-1-i] = aux;
    }
}

void mostrarVector(int v[], int n){
    for(int i=0; i<n; i++){
        cout<<v[i]<<" ";
    }

    cout<<endl;
}
