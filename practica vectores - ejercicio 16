#include<iostream>
#include<string>
using namespace std;

void ingresarAlumno(string alumnos[], float notas[], int &n);
void listarAlumnos(string alumnos[], float notas[], int n);
void ordenarAlfabeticamente(string alumnos[], float notas[], int n);
float mejorNota(float notas[], int n);
float promedioNotas(float notas[], int n);

int main(){
    string alumnos[100];
    float notas[100];
    int n = 0;
    int opcion;

    do{
        cout<<"\n===== MENU ====="<<endl;
        cout<<"1. Ingresar alumno y nota"<<endl;
        cout<<"2. Listar alumnos"<<endl;
        cout<<"3. Ordenar alfabeticamente"<<endl;
        cout<<"4. Sacar la mejor nota"<<endl;
        cout<<"5. Sacar el promedio"<<endl;
        cout<<"6. Salir"<<endl;
        cout<<"Opcion: ";
        cin>>opcion;
        cin.ignore();

        switch(opcion){

        case 1:
            ingresarAlumno(alumnos, notas, n);
            break;

        case 2:
            listarAlumnos(alumnos, notas, n);
            break;

        case 3:
            ordenarAlfabeticamente(alumnos, notas, n);
            cout<<"Alumnos ordenados correctamente."<<endl;
            break;

        case 4:
            if(n > 0)
                cout<<"La mejor nota es: "<<mejorNota(notas, n)<<endl;
            else
                cout<<"No hay alumnos registrados."<<endl;
            break;

        case 5:
            if(n > 0)
                cout<<"El promedio es: "<<promedioNotas(notas, n)<<endl;
            else
                cout<<"No hay alumnos registrados."<<endl;
            break;

        case 6:
            cout<<"Fin del programa."<<endl;
            break;

        default:
            cout<<"Opcion incorrecta."<<endl;
        }

    }while(opcion != 6);

    return 0;
}

void ingresarAlumno(string alumnos[], float notas[], int &n){
    cout<<"Nombre del alumno: ";
    getline(cin, alumnos[n]);

    cout<<"Nota: ";
    cin>>notas[n];
    cin.ignore();

    n++;
}

void listarAlumnos(string alumnos[], float notas[], int n){
    cout<<"\nLISTA DE ALUMNOS"<<endl;

    for(int i=0; i<n; i++){
        cout<<alumnos[i]<<" - "<<notas[i]<<endl;
    }
}

void ordenarAlfabeticamente(string alumnos[], float notas[], int n){
    string auxAlumno;
    float auxNota;

    for(int i=0; i<n-1; i++){
        for(int j=i+1; j<n; j++){

            if(alumnos[i] > alumnos[j]){

                auxAlumno = alumnos[i];
                alumnos[i] = alumnos[j];
                alumnos[j] = auxAlumno;

                auxNota = notas[i];
                notas[i] = notas[j];
                notas[j] = auxNota;
            }
        }
    }
}

float mejorNota(float notas[], int n){
    float mayor = notas[0];

    for(int i=1; i<n; i++){
        if(notas[i] > mayor){
            mayor = notas[i];
        }
    }

    return mayor;
}

float promedioNotas(float notas[], int n){
    float suma = 0;

    for(int i=0; i<n; i++){
        suma += notas[i];
    }

    return suma / n;
}
