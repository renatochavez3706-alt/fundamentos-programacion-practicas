#include<iostream>
using namespace std;

void generarFibonacci(int fibonacci[], int n);
void mostrarVector(int fibonacci[], int n);

int main(){
    int fibonacci[100];
    int n;

    cout<<"Ingrese la cantidad de terminos: ";
    cin>>n;

    generarFibonacci(fibonacci, n);

    cout<<"\nSERIE DE FIBONACCI:"<<endl;
    mostrarVector(fibonacci, n);

    return 0;
}

void generarFibonacci(int fibonacci[], int n){

    if(n >= 1){
        fibonacci[0] = 0;
    }

    if(n >= 2){
        fibonacci[1] = 1;
    }

    for(int i=2; i<n; i++){
        fibonacci[i] = fibonacci[i-1] + fibonacci[i-2];
    }
}

void mostrarVector(int fibonacci[], int n){
    for(int i=0; i<n; i++){
        cout<<fibonacci[i]<<" ";
    }

    cout<<endl;
}
