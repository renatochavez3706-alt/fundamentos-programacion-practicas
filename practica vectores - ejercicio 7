#include<iostream>
using namespace std;

void cargarNumeros(string numeros[]);
void mostrarLiteral(string numeros[], int n);

int main(){
    string numeros[21];
    int n;

    cargarNumeros(numeros);

    cout<<"Ingrese un numero entre 0 y 20: ";
    cin>>n;

    mostrarLiteral(numeros, n);

    return 0;
}

void cargarNumeros(string numeros[]){
    numeros[0]="CERO";
    numeros[1]="UNO";
    numeros[2]="DOS";
    numeros[3]="TRES";
    numeros[4]="CUATRO";
    numeros[5]="CINCO";
