    numeros[7]="SIETE";
    numeros[8]="OCHO";
    numeros[9]="NUEVE";
    numeros[10]="DIEZ";
    numeros[11]="ONCE";
    numeros[12]="DOCE";
    numeros[13]="TRECE";
    numeros[14]="CATORCE";
    numeros[15]="QUINCE";
    numeros[16]="DIECISEIS";
    numeros[17]="DIECISIETE";
    numeros[18]="DIECIOCHO";
    numeros[19]="DIECINUEVE";
