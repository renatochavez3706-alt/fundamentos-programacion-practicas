#include <iostream>
using namespace std;

int main() {
    int dia, mes, anio;

    cout << "Ingrese el dia: ";
    cin >> dia;

    cout << "Ingrese el mes: ";
    cin >> mes;

    cout << "Ingrese el anio: ";
    cin >> anio;

    // Determinar estacion
    if ((mes == 9 && dia >= 21) || (mes == 10) || (mes == 11) || (mes == 12 && dia < 21)) {
        cout << "La estacion es: Primavera";
    }
    else if ((mes == 12 && dia >= 21) || (mes == 1) || (mes == 2) || (mes == 3 && dia < 21)) {
        cout << "La estacion es: Verano";
    }
    else if ((mes == 3 && dia >= 21) || (mes == 4) || (mes == 5) || (mes == 6 && dia < 21)) {
        cout << "La estacion es: Otono";
    }
    else if ((mes == 6 && dia >= 21) || (mes == 7) || (mes == 8) || (mes == 9 && dia < 21)) {
        cout << "La estacion es: Invierno";
    }
    else {
        cout << "Fecha no valida";
    }

    return 0;
}
