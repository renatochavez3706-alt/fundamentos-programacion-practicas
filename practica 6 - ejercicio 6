#include <iostream>
#include <cmath>
using namespace std;

int main() {
    float a, b, c;
    float x1, x2, discriminante;

    cout << "Ingrese el valor de a: ";
    cin >> a;

    cout << "Ingrese el valor de b: ";
    cin >> b;

    cout << "Ingrese el valor de c: ";
    cin >> c;
    if (a == 0) {

        if (b != 0) {
            x1 = -c / b;
            cout << "La ecuacion es lineal" << endl;
            cout << "La solucion es x = " << x1;
        }

        else if (b == 0 && c == 0) {
            cout << "La ecuacion tiene infinitas soluciones";
        }

        else {
            cout << "La ecuacion no tiene solucion";
        }
    }
    else {

        discriminante = (b * b) - (4 * a * c);

        if (discriminante > 0) {
            x1 = (-b + sqrt(discriminante)) / (2 * a);
            x2 = (-b - sqrt(discriminante)) / (2 * a);

            cout << "Dos soluciones reales diferentes:" << endl;
            cout << "x1 = " << x1 << endl;
            cout << "x2 = " << x2 << endl;
        }

        else if (discriminante == 0) {
            x1 = -b / (2 * a);

            cout << "Una solucion real doble:" << endl;
            cout << "x1 = x2 = " << x1;
        }

        else {
            float parteReal, parteImaginaria;

            parteReal = -b / (2 * a);
            parteImaginaria = sqrt(-discriminante) / (2 * a);

            cout << "Las soluciones son complejas:" << endl;
            cout << "x1 = " << parteReal << " + " << parteImaginaria << "i" << endl;
            cout << "x2 = " << parteReal << " - " << parteImaginaria << "i";
        }
    }

    return 0;
}
