#include<iostream>
using namespace std;

void leerVector(float v[], int n);
float maximoValor(float v[], int n);
void mostrarResultado(float v[], int n, float maximo);

int main(){
    float v[100];
    int n;
    float maximo;

    cout<<"Ingrese la cantidad de valores: "<<endl;
    cin>>n;

    leerVector(v, n);

    maximo = maximoValor(v, n);

    mostrarResultado(v, n, maximo);

    return 0;
}

void leerVector(float v[], int n){
    for(int i=0; i<n; i++){
        cout<<"Ingrese el valor "<<i+1<<": "<<endl;
        cin>>v[i];
    }
}

float maximoValor(float v[], int n){
    float maximo = v[0];

    for(int i=0; i<n; i++){
        if(v[i] > maximo){
            maximo = v[i];
        }
    }

    return maximo;
}

void mostrarResultado(float v[], int n, float maximo){
    cout<<"VALORES REGISTRADOS: "<<endl;

    for(int i=0; i<n; i++){
        cout<<v[i]<<" ";
    }

    cout<<endl;
    cout<<"El maximo valor es: "<<maximo<<endl;
}
