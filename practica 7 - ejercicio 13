#include<iostream>
#include<cmath>
using namespace std;

void leerDatos(float &r, int &n);
float redondear(float r, int n);
void mostrarResultado(float resultado);

int main(){

    float r, resultado;
    int n;

    leerDatos(r, n);

    resultado = redondear(r, n);

    mostrarResultado(resultado);

    return 0;
}

void leerDatos(float &r, int &n){

    cout<<"Ingrese un numero real: "<<endl;
    cin>>r;

    cout<<"Ingrese la cantidad de decimales: "<<endl;
    cin>>n;
}

float redondear(float r, int n){

    float factor, resultado;

    factor = pow(10, n);

    resultado = round(r * factor) / factor;

    return resultado;
}

void mostrarResultado(float resultado){

    cout<<"El numero redondeado es: "<<resultado<<endl;
}
