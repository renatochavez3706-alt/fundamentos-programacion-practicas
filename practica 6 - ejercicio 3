#include <iostream>
using namespace std;

int main() {
    int N;
    int u, d, c, m;

    cout << "Ingrese un numero entero positivo menor que 10000: ";
    cin >> N;

    if (N >= 0 && N < 10000) {

        u = N % 10;
        d = (N / 10) % 10;
        c = (N / 100) % 10;
        m = (N / 1000) % 10;

        cout << "Unidades: " << u << endl;
        cout << "Decenas: " << d << endl;
        cout << "Centenas: " << c << endl;
        cout << "Unidades de mil: " << m << endl;
    }
    else {
        cout << "Numero fuera de rango";
    }

    return 0;
}
